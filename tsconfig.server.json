	"compilerOptions": {
		"composite": true,
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"outDir": "./lib/",
		"rootDir": "./src/",
		"types": ["node"]
	},
	"include": [
